{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaap.invalid/schemas/mod-manifest-v1.schema.json",
  "title": "Yaap mod manifest 1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "name", "version", "api", "kind", "permissions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*){2,}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "publisher": {
      "type": "object",
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
    },
    "api": {
      "type": "object",
      "required": ["minimum", "maximumExclusive"],
      "properties": {
        "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "maximumExclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "kind": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["theme", "ui-extension", "provider"]}
    },
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
