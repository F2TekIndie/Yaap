{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaap.invalid/schemas/provider-message-v1.schema.json",
  "title": "Yaap provider protocol message 1",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "protocol", "id", "method", "params"],
      "properties": {
        "type": {"const": "request"},
        "protocol": {"const": 1},
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "method": {"type": "string", "minLength": 1},
        "params": {"type": "object"}
      }
    },
    {
      "type": "object",
      "required": ["type", "protocol", "id"],
      "properties": {
        "type": {"const": "response"},
        "protocol": {"const": 1},
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
        }
      }
    }
  ]
}
