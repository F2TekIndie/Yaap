root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp}]
indent_size = 4

[*.qml]
indent_size = 4

[{CMakeLists.txt,*.cmake,*.json,*.yml,*.yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

